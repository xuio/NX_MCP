{
  "transport": "MCP stdio -> descriptor bridge -> NX host",
  "schema": {
    "name": "nx_sim_job_status",
    "title": null,
    "description": "Inspect a persistent Simcenter job record without launching, retrying or changing it. job_folder is its workspace-relative storage folder; job_id is its durable ID. Returns recorded state/revision, observation time, request hash and retry prohibition. Optional manifest/evidence expand the compact default. This reads persisted observations, not live process status: a launch return is not proof of solver execution, and solver exit is not numerical validation. Incomplete records return state unknown and prohibit automatic relaunch. Missing jobs and paths outside the workspace are errors. Requires the bridge to respond; background process monitoring and cancellation are not implemented by this tool.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "job_folder": {
          "default": "simcenter-jobs",
          "title": "Job Folder",
          "type": "string"
        },
        "include_manifest": {
          "default": false,
          "title": "Include Manifest",
          "type": "boolean"
        },
        "include_evidence": {
          "default": false,
          "title": "Include Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "nx_sim_job_statusArguments",
      "type": "object"
    },
