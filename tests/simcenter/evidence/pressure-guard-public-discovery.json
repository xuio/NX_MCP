                "type": "null"
              }
            ],
            "title": "Units"
          },
          "operation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Operation Id"
          },
          "mutation_outcome": {
            "anyOf": [
              {
                "enum": [
                  "not_started",
                  "running",
                  "committed",
                  "rolled_back",
                  "partial",
                  "unknown",
                  "not_applicable"
                ]
              },
